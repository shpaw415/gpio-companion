{
	"name": "gpio-companion-monorepo",
	"private": true,
	"version": "0.0.0",
	"description": "gpio-companion monorepo — apps, packages, and compiled binary",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shpaw415/gpio-companion.git"
	},
	"bugs": {
		"url": "https://github.com/shpaw415/gpio-companion/issues"
	},
	"homepage": "https://github.com/shpaw415/gpio-companion#readme",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"binary/*"
		],
		"catalog": {
			"@types/bun": "latest",
			"typescript": "^5.9.3"
		}
	},
	"scripts": {
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"dev": "bun run --filter gpio-companion-web dev",
		"compile": "bun run --filter gpio-companion-bin compile"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10"
	},
	"engines": {
		"bun": ">=1.2.0"
	},
	"license": "MIT"
}
