{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "gpio-companion-dashboard",
	"pages_build_output_dir": ".frame-master/build",
	"compatibility_date": "2026-02-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"BUN_VERSION": "1.4.0",
		"SKIP_DEPENDENCY_INSTALL": "true",
		"PUBLIC_AUTH_CLIENT_ID": "__gpio_companion_927ffcf9",
		"PUBLIC_AUTH_ISSUER": "https://c138e26ec90148fd88735d42f445004c-auth.webcreas.com",
		"PUBLIC_AUTH_REDIRECT_URI": "https://gpio-companion.com/callback"
	},
	"kv_namespaces": [
		{
			"binding": "DYNAMIC_PAGE_KV",
			"id": "91a78de240bc421187afe64a498d0014"
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	}
}