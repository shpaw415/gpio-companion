{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "gpio-companion",
	"version": "0.0.0",
	"identifier": "com.gpiocompanion.desktop",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "gpio-companion",
				"width": 1280,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["gpio-companion-desktop"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.ico"
		],
		"macOS": {
			"infoPlist": "Info.plist"
		}
	}
}
